/*
 * Planck keymap adapted for the Blank Slate ZMK keyboard.
 * Plover layer removed at the user's request.
 * Original source: user-provided Planck QMK keymap.c
 *
 * Physical layout: one centered 2u spacebar (not split/double spacebars).
 * The original QMK grid keymap had two adjacent KC_SPC entries; those are
 * collapsed into the single physical 2u position here.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* Keep the Blank Slate's centered 2u physical layout. */
#define TBLE_MIT 1

/* Layer indices. Keep the base layers first so momentary layers work on all. */
#define LINUX  0
#define MACOS  1
//#define COLEMAK 2
//#define DVORAK  3
#define LOWER   4
#define RAISE   5
#define ADJUST  6

/ {
    chosen {
        zmk,physical-layout =
#ifdef TBLE_MIT
            &layout_ortho_4x12_1x2u;
#else
            &layout_ortho_4x12_all1u;
#endif
    };

    /* QMK's Lower + Raise -> Adjust tri-layer. */
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        linux {
            display-name = "LINUX";
            bindings = <
                &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y   &kp U      &kp I      &kp O      &kp P      &kp BSPC
                &kp ESC    &kp A      &kp S      &kp D      &kp F      &kp G      &kp H   &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
                &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N   &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RET
                &kp RALT   &kp LCTRL  &kp LGUI   &kp LALT   &mo LOWER      &kp SPACE      &mo RAISE  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT
            >;
        };

        macos {
            display-name = "MACOS";
            bindings = <
                &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y   &kp U      &kp I      &kp O      &kp P      &kp BSPC
                &kp ESC    &kp A      &kp S      &kp D      &kp F      &kp G      &kp H   &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
                &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N   &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RET
                &kp RALT   &kp LCTRL  &kp LALT   &kp LGUI   &mo LOWER      &kp SPACE      &mo RAISE  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT
            >;
        };
/*
        colemak {
            display-name = "Colemak";
            bindings = <
                &kp TAB    &kp Q      &kp W      &kp F      &kp P      &kp G      &kp J   &kp L      &kp U      &kp Y      &kp SEMI   &kp BSPC
                &kp ESC    &kp A      &kp R      &kp S      &kp T      &kp D      &kp H   &kp N      &kp E      &kp I      &kp O      &kp SQT
                &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp K   &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RET
                &kp RALT  &kp LCTRL  &kp LGUI   &kp LALT   &mo LOWER       &kp SPACE      &mo RAISE  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT
            >;
        };

        dvorak {
            display-name = "Dvorak";
            bindings = <
                &kp TAB    &kp SQT    &kp COMMA  &kp DOT    &kp P      &kp Y      &kp F   &kp G      &kp C      &kp R      &kp L      &kp BSPC
                &kp ESC    &kp A      &kp O      &kp E      &kp U      &kp I      &kp D   &kp H      &kp T      &kp N      &kp S      &kp FSLH
                &kp LSHFT  &kp SEMI   &kp Q      &kp J      &kp K      &kp X      &kp B   &kp M      &kp W      &kp V      &kp Z      &kp RET
                &kp RSHFT  &kp LCTRL  &kp LALT   &kp LGUI   &mo LOWER      &kp SPACE      &mo RAISE  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT
            >;
        };
*/
        lower {
            display-name = "Lower";
            bindings = <
                &kp TILDE  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT  &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp BSPC
                &kp DEL    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE
                &trans     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12    &kp LS(NUHS) &kp LS(NUBS) &kp HOME   &kp END    &trans
                &trans     &trans     &trans     &trans     &trans          &trans           &trans     &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP &kp C_PP
            >;
        };

        raise {
            display-name = "Raise";
            bindings = <
                &kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
                &kp DEL    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH
                &trans     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12    &kp NUHS   &kp NUBS   &kp PG_UP  &kp PG_DN  &trans
                &trans     &trans     &trans     &trans     &trans          &trans           &trans     &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP &kp C_PP
            >;
        };

        adjust {
            display-name = "Adjust";
            bindings = <
                &bt BT_CLR &bootloader  &trans       &trans       &trans       &trans       &trans    &trans &trans &trans &trans &kp DEL
                &trans     &trans       &trans       &trans       &trans       &to LINUX    &to MACOS &trans &trans &trans &trans &studio_unlock
                &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans    &trans &trans &trans &trans &trans
                &trans     &trans       &trans       &trans       &trans              &trans          &trans &trans &trans &trans &trans
            >;
        };
    };
};
